{
  "name": "game-test",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "shot": "node scripts/shot.mjs",
    "perf": "node scripts/perf.mjs",
    "assets:fetch": "node scripts/assets/fetch.mjs",
    "assets:audio": "node scripts/audio/build.mjs",
    "assets:audio:check": "node scripts/audio/build.mjs --check",
    "assets:audio:synth": "python3 scripts/audio/synth/build.py",
    "assets:build": "node scripts/assets/fetch.mjs && node scripts/assets/build.mjs",
    "assets:equipment": "node scripts/assets/build-equipment.mjs",
    "assets:exploration": "node scripts/assets/build-exploration.mjs",
    "assets:environment": "node scripts/assets/build-environment.mjs",
    "assets:player": "node scripts/assets/build-player.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "meshoptimizer": "1.3.0",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
